<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- 1. Tell Windows to handle requests via iisnode -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- 2. Disable iisnode logging to bypass the 0x2 write-permission crash -->
    <iisnode devErrorsEnabled="true" loggingEnabled="false" />

    <rewrite>
      <rules>
        <!-- 3. Forward ALL traffic directly to Express. Express will handle APIs and UI static files. -->
        <rule name="ExpressApp">
          <match url="/*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>
    
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>